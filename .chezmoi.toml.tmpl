# chezmoi config, generated at `chezmoi init` time.
#
# To prompt each adopter for per-user values (email, name, work-vs-personal, ...)
# at init time, add a promptStringOnce/promptBoolOnce call plus a [data] table
# here. See: https://www.chezmoi.io/reference/special-files/chezmoi-format-tmpl/

[git]
    autoCommit = true   # commit source changes locally on `chezmoi apply`
    autoPush = true     # and push them — you init from your own fork, so this is safe
